# Credenciais do MySQL local — não versionar este arquivo.

# superusuário nativo
MYSQL_ROOT_PASSWORD=root

# administrador com nome próprio (criado por initdb/00-admin-user.sh)
DB_ADMIN_USER=admin
DB_ADMIN_PASSWORD=admin123

# usuário comum (aluno) — acesso a aula_views e aula_exercicios
MYSQL_USER=aluno
MYSQL_PASSWORD=aluno123

# banco criado automaticamente pelo entrypoint oficial
MYSQL_DATABASE=aula_views

# porta publicada no host
MYSQL_PORT=3306

TZ=America/Sao_Paulo
